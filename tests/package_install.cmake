# Install the current build, move it, and consume only the moved prefix.
# GNU time adds resource evidence on Linux without becoming a required dependency.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  find_program(packageResourceTimer NAMES time PATHS /usr/bin NO_DEFAULT_PATH)
endif()
function(runStep)
  string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
  message(STATUS "Package step started ${started}: ${ARGV}")
  if(packageResourceTimer)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E time "${packageResourceTimer}" -v ${ARGV}
      RESULT_VARIABLE result)
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E time ${ARGV} RESULT_VARIABLE result)
  endif()
  string(TIMESTAMP ended "%Y-%m-%dT%H:%M:%SZ" UTC)
  message(STATUS "Package step ended ${ended}: result=${result}")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Package test command failed (${result}): ${ARGV}")
  endif()
endfunction()

foreach(required IN ITEMS SOURCE_DIR BINARY_DIR GENERATOR CXX_COMPILER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Package install test requires ${required}")
  endif()
endforeach()

if(PACKAGE_BOTH_CONFIGS)
  set(INSTALL_CONFIGS Debug Release)
endif()

# ALL preserves direct script invocation; CTest separates setup from runtime checks.
if(NOT DEFINED PACKAGE_PHASE)
  set(PACKAGE_PHASE ALL)
endif()
if(NOT PACKAGE_PHASE MATCHES "^(ALL|PREPARE|VERIFY)$")
  message(FATAL_ERROR "PACKAGE_PHASE must be ALL, PREPARE or VERIFY")
endif()
get_filename_component(binaryRoot "${BINARY_DIR}" ABSOLUTE)
if(NOT PACKAGE_PHASE STREQUAL "ALL")
  if(NOT DEFINED PACKAGE_STATE_FILE OR NOT IS_ABSOLUTE "${PACKAGE_STATE_FILE}")
    message(FATAL_ERROR "Split package phases require an absolute PACKAGE_STATE_FILE")
  endif()
  cmake_path(IS_PREFIX binaryRoot "${PACKAGE_STATE_FILE}" NORMALIZE stateInsideBuild)
  if(NOT stateInsideBuild)
    message(FATAL_ERROR "Package state must stay in its build directory")
  endif()
endif()
if(PACKAGE_PHASE STREQUAL "PREPARE")
  # A failed new setup must never leave a previously successful fixture available.
  file(REMOVE "${PACKAGE_STATE_FILE}")
endif()

function(verifyConsumer consumerBuild)
  if(DEFINED INSTALL_CONFIGS)
    set(configurations ${INSTALL_CONFIGS})
  else()
    set(configurations "${CONFIG}")
  endif()
  foreach(consumerConfig IN LISTS configurations)
    runStep("${CMAKE_CTEST_COMMAND}" --test-dir "${consumerBuild}" -C "${consumerConfig}"
      --output-on-failure --no-tests=error -V)
  endforeach()
endfunction()

if(PACKAGE_PHASE STREQUAL "VERIFY")
  if(NOT EXISTS "${PACKAGE_STATE_FILE}")
    message(FATAL_ERROR "Package preparation has not produced a ready fixture")
  endif()
  file(READ "${PACKAGE_STATE_FILE}" consumerBuild)
  # The marker contains one owning fresh build path, never executable CMake input.
  if(consumerBuild MATCHES "[\r\n]")
    message(FATAL_ERROR "Malformed package fixture path")
  endif()
  cmake_path(IS_PREFIX binaryRoot "${consumerBuild}" NORMALIZE consumerInsideBuild)
  if(NOT IS_ABSOLUTE "${consumerBuild}" OR NOT consumerInsideBuild OR
      NOT EXISTS "${consumerBuild}/CMakeCache.txt")
    message(FATAL_ERROR "Package fixture is missing or outside the producer build")
  endif()
  verifyConsumer("${consumerBuild}")
  message(STATUS "Relocated consumer verified: ${consumerBuild}")
  return()
endif()

# File input preserves a producer's runtime generator expression for both consumer configurations.
# The direct MSVC_RUNTIME_LIBRARY argument remains supported when no file is supplied.
if(DEFINED MSVC_RUNTIME_LIBRARY_FILE)
  if("${MSVC_RUNTIME_LIBRARY_FILE}" STREQUAL "" OR NOT EXISTS "${MSVC_RUNTIME_LIBRARY_FILE}")
    message(FATAL_ERROR "MSVC_RUNTIME_LIBRARY_FILE must name an existing runtime settings file")
  endif()
  file(READ "${MSVC_RUNTIME_LIBRARY_FILE}" MSVC_RUNTIME_LIBRARY)
endif()

# Keep nested MSBuild/Ninja concurrency explicit without relying on the parent CTest job count.
if(NOT DEFINED PACKAGE_CONSUMER_BUILD_JOBS)
  set(PACKAGE_CONSUMER_BUILD_JOBS 4)
endif()
if(NOT PACKAGE_CONSUMER_BUILD_JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "PACKAGE_CONSUMER_BUILD_JOBS must be a positive integer")
endif()

# Fresh directories avoid removing unrelated user files or previous evidence.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
get_filename_component(binaryRoot "${BINARY_DIR}" ABSOLUTE)
set(testRoot "${binaryRoot}/package-install-${CONFIG}-${runId}")
set(prefix "${testRoot}/original prefix")
set(relocated "${testRoot}/relocated package é")
set(consumerSource "${testRoot}/consumer source")
set(consumerBuild "${testRoot}/consumer build")
foreach(path IN ITEMS "${prefix}" "${relocated}" "${consumerSource}" "${consumerBuild}")
  cmake_path(IS_PREFIX binaryRoot "${path}" NORMALIZE insideBuild)
  if(NOT insideBuild)
    message(FATAL_ERROR "Package test path escapes its build directory: ${path}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${prefix}" "${consumerSource}")

if(DEFINED INSTALL_CONFIGS)
  foreach(installConfig IN LISTS INSTALL_CONFIGS)
    runStep("${CMAKE_COMMAND}" --build "${BINARY_DIR}" --config "${installConfig}" --target portals_core)
    runStep("${CMAKE_COMMAND}" --install "${BINARY_DIR}" --config "${installConfig}" --prefix "${prefix}")
  endforeach()
else()
  runStep("${CMAKE_COMMAND}" --install "${BINARY_DIR}" --config "${CONFIG}" --prefix "${prefix}")
endif()
file(RENAME "${prefix}" "${relocated}")
include("${SOURCE_DIR}/tools/package/common.cmake")
bundleStageConsumer("${SOURCE_DIR}" "${consumerSource}")

set(configureArgs -S "${consumerSource}" -B "${consumerBuild}" -G "${GENERATOR}"
  "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
  "-DCMAKE_PREFIX_PATH=${relocated}"
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
  -DCMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH=OFF -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
if(DEFINED PORTALS_PACKAGE_CONSUMER_MINIMAL_DEBUG_INFO)
  list(APPEND configureArgs
    "-DPORTALS_PACKAGE_CONSUMER_MINIMAL_DEBUG_INFO=${PORTALS_PACKAGE_CONSUMER_MINIMAL_DEBUG_INFO}")
endif()
foreach(setting IN ITEMS MAKE_PROGRAM GENERATOR_PLATFORM GENERATOR_TOOLSET MSVC_RUNTIME_LIBRARY
    LINK_DEPENDS_USE_LINKER)
  if(DEFINED ${setting} AND NOT "${${setting}}" STREQUAL "")
    list(APPEND configureArgs "-DCMAKE_${setting}=${${setting}}")
  endif()
endforeach()
runStep("${CMAKE_COMMAND}" ${configureArgs})

file(GLOB_RECURSE exportedFiles "${relocated}/*.cmake")
foreach(exported IN LISTS exportedFiles)
  file(READ "${exported}" contents)
  foreach(forbidden IN ITEMS "${SOURCE_DIR}" "${BINARY_DIR}" "${prefix}" "/W4" "/permissive-"
      "-Wall" "-Wextra" "-Wpedantic" "UTF8PROC_STATIC" "vendor/utf8proc")
    string(FIND "${contents}" "${forbidden}" found)
    if(NOT found EQUAL -1)
      message(FATAL_ERROR "Non-relocatable/private setting in ${exported}: ${forbidden}")
    endif()
  endforeach()
endforeach()

if(DEFINED INSTALL_CONFIGS)
  set(configurations ${INSTALL_CONFIGS})
else()
  set(configurations "${CONFIG}")
endif()
foreach(consumerConfig IN LISTS configurations)
  runStep("${CMAKE_COMMAND}" --build "${consumerBuild}" --config "${consumerConfig}"
    --parallel "${PACKAGE_CONSUMER_BUILD_JOBS}")
endforeach()
if(PACKAGE_PHASE STREQUAL "PREPARE")
  file(WRITE "${PACKAGE_STATE_FILE}.tmp" "${consumerBuild}")
  file(RENAME "${PACKAGE_STATE_FILE}.tmp" "${PACKAGE_STATE_FILE}")
  message(STATUS "Relocated consumer prepared; evidence retained in ${testRoot}")
else()
  verifyConsumer("${consumerBuild}")
  message(STATUS "Relocated consumer verified; evidence retained in ${testRoot}")
endif()
