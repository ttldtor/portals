# Exercise package phase admission and verification without compiling the SDK.
cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS SOURCE_DIR BINARY_DIR GENERATOR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Package fixture test requires ${required}")
  endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef runId)
set(root "${BINARY_DIR}/package-fixture-${runId}")
set(source "${root}/source")
set(build "${root}/build")
set(marker "${root}/consumer.ready")
file(MAKE_DIRECTORY "${source}")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(PackageFixtureProbe NONE)
enable_testing()
add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/group_a.o"
  COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_CURRENT_BINARY_DIR}/group_a.o")
add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/group_b.o"
  COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_CURRENT_BINARY_DIR}/group_b.o")
add_custom_target(default_a ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/group_a.o")
add_custom_target(default_b ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/group_b.o")
add_custom_target(portals_package_group_a DEPENDS default_a)
if(FAIL_BUILD)
  add_custom_target(portals_package_group_b COMMAND "${CMAKE_COMMAND}" -E false)
else()
  add_custom_target(portals_package_group_b DEPENDS default_b)
endif()
if(OMIT_TARGET)
  add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/omitted.o"
    COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_CURRENT_BINARY_DIR}/omitted.o")
  add_custom_target(omitted ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/omitted.o")
endif()
if(FAIL_PROBE)
  add_test(NAME consumer.probe COMMAND "${CMAKE_COMMAND}" -E false)
else()
  add_test(NAME consumer.probe COMMAND "${CMAKE_COMMAND}" -E true)
endif()
]=])
# Configure the real fixture registration with both supported budget scales.
file(READ "${SOURCE_DIR}/CMakeLists.txt" producerCmake)
string(FIND "${producerCmake}" [=[portals_add_package_fixture(portals.package-install "${PORTALS_PACKAGE_TEST_TIMEOUT}")]=] singleBudget)
string(FIND "${producerCmake}" [=[math(EXPR portals_package_multi_config_timeout "${PORTALS_PACKAGE_TEST_TIMEOUT} * 2")]=] multiBudget)
if(singleBudget LESS 0 OR multiBudget LESS 0)
  message(FATAL_ERROR "Package fixture budget scaling changed")
endif()
string(FIND "${producerCmake}" "  function(portals_add_package_fixture " fixtureOffset)
string(FIND "${producerCmake}" "  # A fresh full consumer build" fixtureEnd)
if(fixtureOffset LESS 0 OR fixtureEnd LESS fixtureOffset)
  message(FATAL_ERROR "Package fixture registration not found")
endif()
math(EXPR fixtureLength "${fixtureEnd} - ${fixtureOffset}")
string(SUBSTRING "${producerCmake}" ${fixtureOffset} ${fixtureLength} fixtureCode)
set(budgetSource "${root}/budget source")
set(budgetBuild "${root}/budget build")
file(MAKE_DIRECTORY "${budgetSource}")
file(WRITE "${budgetSource}/CMakeLists.txt"
  "cmake_minimum_required(VERSION 3.24)\nproject(Budget NONE)\nenable_testing()\nset(portals_package_test_command \"${CMAKE_COMMAND}\")\n${fixtureCode}\nportals_add_package_fixture(single 1200)\nmath(EXPR multiTimeout \"1200 * 2\")\nportals_add_package_fixture(multi \"\${multiTimeout}\")\n")
set(budgetConfigure "${CMAKE_COMMAND}" -S "${budgetSource}" -B "${budgetBuild}" -G "${GENERATOR}")
if(DEFINED MAKE_PROGRAM AND NOT "${MAKE_PROGRAM}" STREQUAL "")
  list(APPEND budgetConfigure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND ${budgetConfigure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not configure budget probe")
endif()
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${budgetBuild}" -C Release --show-only=json-v1
  OUTPUT_VARIABLE budgetJson RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not inspect fixture budgets")
endif()
string(JSON testCount LENGTH "${budgetJson}" tests)
if(NOT testCount EQUAL 6)
  message(FATAL_ERROR "Expected six fixture phases")
endif()
foreach(i RANGE 0 5)
  string(JSON testName GET "${budgetJson}" tests ${i} name)
  if(testName MATCHES "^single")
    set(expectedTimeout 1200.0)
  else()
    set(expectedTimeout 2400.0)
  endif()
  string(JSON propertyCount LENGTH "${budgetJson}" tests ${i} properties)
  math(EXPR lastProperty "${propertyCount} - 1")
  set(foundTimeout FALSE)
  foreach(j RANGE 0 ${lastProperty})
    string(JSON propertyName GET "${budgetJson}" tests ${i} properties ${j} name)
    if(propertyName STREQUAL "TIMEOUT")
      string(JSON timeout GET "${budgetJson}" tests ${i} properties ${j} value)
      if(NOT timeout EQUAL expectedTimeout)
        message(FATAL_ERROR "Unexpected timeout for ${testName}: ${timeout}")
      endif()
      set(foundTimeout TRUE)
    endif()
  endforeach()
  if(NOT foundTimeout)
    message(FATAL_ERROR "Missing timeout for ${testName}")
  endif()
endforeach()

# Exercise the actual deferred grouping code, including a declaration after its hook.
file(READ "${SOURCE_DIR}/tests/package_consumer/CMakeLists.txt" consumerCmake)
string(FIND "${consumerCmake}" "# Snapshot all declarations at the end" groupOffset)
if(groupOffset LESS 0)
  message(FATAL_ERROR "Package partition hook not found")
endif()
string(SUBSTRING "${consumerCmake}" ${groupOffset} -1 groupCode)
set(inventorySource "${root}/inventory source")
set(inventoryBuild "${root}/inventory build")
file(MAKE_DIRECTORY "${inventorySource}")
file(WRITE "${inventorySource}/CMakeLists.txt"
  "cmake_minimum_required(VERSION 3.24)\nproject(Inventory NONE)\nadd_custom_target(early ALL)\nadd_custom_target(negative)\nset_property(TARGET negative PROPERTY EXCLUDE_FROM_ALL TRUE)\n${groupCode}\nadd_custom_target(late ALL)\n")
set(inventoryConfigure "${CMAKE_COMMAND}" -S "${inventorySource}" -B "${inventoryBuild}" -G "${GENERATOR}")
if(DEFINED MAKE_PROGRAM AND NOT "${MAKE_PROGRAM}" STREQUAL "")
  list(APPEND inventoryConfigure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND ${inventoryConfigure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not configure inventory probe")
endif()
file(READ "${inventoryBuild}/package-target-inventory.txt" inventory)
if(NOT inventory STREQUAL "eligible=early;late\ngroup_a=early\ngroup_b=late\n")
  message(FATAL_ERROR "Incorrect deferred target inventory: ${inventory}")
endif()
set(configure "${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G "${GENERATOR}")
if(DEFINED MAKE_PROGRAM AND NOT "${MAKE_PROGRAM}" STREQUAL "")
  list(APPEND configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND ${configure} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not configure fixture probe")
endif()
function(expectPhase phase success)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGE_PHASE=${phase}" ${ARGN}
    "-DSOURCE_DIR=${SOURCE_DIR}" "-DBINARY_DIR=${root}" "-DGENERATOR=${GENERATOR}"
    -DCXX_COMPILER=unused -DCONFIG=Release "-DPACKAGE_STATE_FILE=${marker}"
    -P "${SOURCE_DIR}/tests/package_install.cmake" RESULT_VARIABLE result)
  if(success AND NOT result EQUAL 0)
    message(FATAL_ERROR "Expected ${phase} success, got ${result}")
  elseif(NOT success AND result EQUAL 0)
    message(FATAL_ERROR "Expected ${phase} failure")
  endif()
endfunction()
# A stale or incomplete setup must never admit a later phase.
expectPhase(BUILD_REST FALSE)
expectPhase(VERIFY FALSE)
string(SHA256 identity "${SOURCE_DIR}|${root}|Release|${GENERATOR}|||unused||||OFF||")
file(WRITE "${marker}" "${identity}\n${build}\n")
expectPhase(VERIFY FALSE)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --target portals_package_group_a
  RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Could not build group A")
endif()
expectPhase(BUILD_REST TRUE)
expectPhase(VERIFY TRUE)
file(WRITE "${marker}" "wrong-identity\n${build}\n")
expectPhase(VERIFY FALSE)
file(WRITE "${marker}" "${identity}\n${build}\n")
execute_process(COMMAND ${configure} -DFAIL_PROBE=ON RESULT_VARIABLE result)
expectPhase(VERIFY FALSE)
execute_process(COMMAND ${configure} -DFAIL_PROBE=OFF -DFAIL_BUILD=ON RESULT_VARIABLE result)
expectPhase(BUILD_REST FALSE)
expectPhase(VERIFY FALSE)
if(GENERATOR MATCHES "^Ninja")
  execute_process(COMMAND ${configure} -DFAIL_BUILD=OFF -DOMIT_TARGET=ON RESULT_VARIABLE result)
  expectPhase(BUILD_REST FALSE)
  expectPhase(VERIFY FALSE)
endif()
expectPhase(PREPARE FALSE "-DMSVC_RUNTIME_LIBRARY_FILE=${root}/missing-runtime.txt")
if(EXISTS "${marker}" OR EXISTS "${marker}.built")
  message(FATAL_ERROR "Failed preparation retained stale fixture state")
endif()
expectPhase(VERIFY FALSE)
message(STATUS "Package phase ordering, failures and Ninja coverage audit passed")
