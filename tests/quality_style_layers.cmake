# Included by quality_tools.cmake: reuse its isolated root, metadata and receipt assertions.
execute_process(COMMAND "${CMAKE_COMMAND}" -DHELP=ON -DMODE=record -DKIND=style_layers
  "-DRAW_FILE=${root}/missing.json" "-DOUTPUT_DIR=${root}/help-must-not-write" -P "${performance}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
file(WRITE "${root}/style-help.log" "${output}${errors}\nExit code: ${result}\n")
assertSuccessful("${result}" "${output}${errors}")
if(NOT "${output}${errors}" MATCHES "style_layers" OR EXISTS "${root}/help-must-not-write")
  message(FATAL_ERROR "style_layers help must list the kind without operational inputs or writes")
endif()
set(styleSeries "{\"count\":3,\"p50\":2,\"p95\":3,\"samples\":[3,1,2]}")
set(styleCase "{\"api\":\"layers\",\"controls\":32,\"theme_rules\":8,\"visibility\":\"visible\",\"operation\":\"theme_handoff\",\"update_kind\":\"changed\",\"update\":${styleSeries},\"frame_render\":${styleSeries},\"defaults_calls\":32,\"paint_calls\":32,\"render_commands\":32,\"effective_invalidation\":1,\"update_redraw_requests\":1,\"explicit_frame_count\":1,\"idle_redraws\":0,\"terminal_output_bytes\":100}")
string(JSON styleLegacy SET "${styleCase}" api "\"legacy_composition\"")
set(style "{\"schema\":1,\"complete\":true,\"correctness_verified\":true,\"check_only\":false,\"compiler\":\"fixture compiler\",\"build\":\"Release\",\"assertions_enabled\":false,\"pointer_bits\":64,\"clock\":\"steady_clock\",\"unit\":\"ns\",\"percentile\":\"nearest_rank\",\"samples_per_case\":3,\"warmup_per_case\":1,\"allocations\":null,\"frame_workload\":\"fixture explicit frame\",\"cases\":[${styleCase},${styleLegacy}]}")
file(WRITE "${root}/style.json" "${style}\n")
record(style-before "${root}/style.json" "${root}/metadata.json" style_layers PASS)
record(style-after "${root}/style.json" "${root}/metadata.json" style_layers PASS)
compare(style-equal style-before style-after PASS "")
file(READ "${root}/style-before/record.json" styleRecord)
string(JSON allocationSignature GET "${styleRecord}" normalized signature allocation_instrumentation)
if(NOT allocationSignature STREQUAL "not_instrumented")
  message(FATAL_ERROR "legacy style_layers report must identify absent instrumentation")
endif()
file(READ "${root}/style-equal.json" styleComparison)
string(JSON timingValue GET "${styleComparison}" metrics 0 after)
string(JSON missingValue TYPE "${styleComparison}" metrics 4 after)
string(JSON missingState GET "${styleComparison}" metrics 4 observation)
string(JSON contextState GET "${styleComparison}" metrics 12 observation)
if(NOT timingValue EQUAL 2 OR NOT missingValue STREQUAL "NULL"
    OR NOT missingState STREQUAL "NOT_MEASURED" OR NOT contextState STREQUAL "CONTEXT")
  message(FATAL_ERROR "style_layers timing, missing allocations or counter evidence is wrong")
endif()

# The optional extension measures ordinary calls and requested bytes per phase.
string(JSON styleAllocated SET "${style}" allocations "\"ordinary_new_calls_and_requested_bytes\"")
foreach(index RANGE 0 1)
  foreach(field update_allocations frame_allocations update_allocated_bytes frame_allocated_bytes)
    string(JSON styleAllocated SET "${styleAllocated}" cases ${index} "${field}" "${styleSeries}")
  endforeach()
endforeach()
file(WRITE "${root}/style-allocated.json" "${styleAllocated}")
record(style-allocated "${root}/style-allocated.json" "${root}/metadata.json" style_layers PASS)
file(READ "${root}/style-allocated/record.json" styleRecord)
string(JSON allocationSignature GET "${styleRecord}" normalized signature allocation_instrumentation)
if(NOT allocationSignature STREQUAL "ordinary_new_calls_and_requested_bytes")
  message(FATAL_ERROR "style_layers report must retain the exact instrumentation method")
endif()
compare(style-allocated-equal style-allocated style-allocated PASS "")
compare(style-optional-allocations style-before style-allocated FAIL "incompatible actual benchmark workload/signature")
file(READ "${root}/style-allocated-equal.json" styleComparison)
foreach(index RANGE 4 11)
  string(JSON allocationUnit GET "${styleComparison}" metrics ${index} unit)
  string(JSON allocationValue GET "${styleComparison}" metrics ${index} after)
  if(index LESS 8)
    set(expectedUnit calls)
  else()
    set(expectedUnit bytes)
  endif()
  if(NOT allocationUnit STREQUAL expectedUnit OR allocationValue LESS 2 OR allocationValue GREATER 3)
    message(FATAL_ERROR "style_layers allocation units or values are wrong")
  endif()
endforeach()
set(styleZero "${styleAllocated}")
foreach(index RANGE 0 1)
  foreach(field update_allocations frame_allocations update_allocated_bytes frame_allocated_bytes)
    string(JSON styleZero SET "${styleZero}" cases ${index} "${field}"
      "{\"count\":3,\"p50\":0,\"p95\":0,\"samples\":[0,0,0]}")
  endforeach()
endforeach()
file(WRITE "${root}/style-zero-allocations.json" "${styleZero}")
record(style-zero-allocations "${root}/style-zero-allocations.json" "${root}/metadata.json" style_layers PASS)
compare(style-zero-allocated style-zero-allocations style-allocated PASS "")
file(READ "${root}/style-zero-allocated.json" styleComparison)
string(JSON zeroBaseline GET "${styleComparison}" metrics 4 before)
string(JSON zeroRatio TYPE "${styleComparison}" metrics 4 after_over_before)
string(JSON zeroState GET "${styleComparison}" metrics 4 observation)
if(NOT zeroBaseline EQUAL 0 OR NOT zeroRatio STREQUAL "NULL" OR NOT zeroState STREQUAL "CANDIDATE_REGRESSION")
  message(FATAL_ERROR "measured zero allocation baseline must remain zero, with undefined ratio")
endif()

foreach(mutation check incomplete unverified schema unit percentile zero-samples empty-cases empty-identity
    missing-identity duplicate count retained-count p50 p95 negative overflow counter allocation-scope
    allocation-missing allocation-count allocation-p95 allocation-negative unmarked-allocations)
  set(changed "${style}")
  set(reason "FAIL")
  if(mutation STREQUAL "check")
    string(JSON changed SET "${changed}" check_only true)
    set(reason "correctness fixtures")
  elseif(mutation STREQUAL "incomplete")
    string(JSON changed SET "${changed}" complete false)
  elseif(mutation STREQUAL "unverified")
    string(JSON changed SET "${changed}" correctness_verified false)
  elseif(mutation STREQUAL "schema")
    string(JSON changed SET "${changed}" schema 2)
  elseif(mutation STREQUAL "unit")
    string(JSON changed SET "${changed}" unit "\"ms\"")
  elseif(mutation STREQUAL "percentile")
    string(JSON changed SET "${changed}" percentile "\"interpolated\"")
  elseif(mutation STREQUAL "zero-samples")
    string(JSON changed SET "${changed}" samples_per_case 0)
  elseif(mutation STREQUAL "empty-cases")
    string(JSON changed SET "${changed}" cases "[]")
  elseif(mutation STREQUAL "empty-identity")
    string(JSON changed SET "${changed}" cases 0 operation "\"\"")
  elseif(mutation STREQUAL "missing-identity")
    string(JSON changed REMOVE "${changed}" cases 0 theme_rules)
  elseif(mutation STREQUAL "duplicate")
    string(JSON changed SET "${changed}" cases 1 "${styleCase}")
    set(reason "duplicate style_layers case identity")
  elseif(mutation STREQUAL "count")
    string(JSON changed SET "${changed}" cases 0 update count 2)
    set(reason "per-case sample count differs")
  elseif(mutation STREQUAL "retained-count")
    string(JSON changed SET "${changed}" cases 0 update samples "[1,2]")
    set(reason "sample count differs from retained raw values")
  elseif(mutation STREQUAL "p50" OR mutation STREQUAL "p95")
    string(JSON changed SET "${changed}" cases 0 frame_render "${mutation}" 0)
    set(reason "raw samples disagree")
  elseif(mutation STREQUAL "negative")
    string(JSON changed SET "${changed}" cases 0 update samples "[-1,2,3]")
    set(reason "unsupported raw sample values")
  elseif(mutation STREQUAL "overflow")
    string(JSON changed SET "${changed}" cases 0 update samples "[1,2,9007199254740992]")
    set(reason "exceeds supported")
  elseif(mutation STREQUAL "counter")
    string(JSON changed SET "${changed}" cases 0 defaults_calls -1)
  elseif(mutation STREQUAL "allocation-scope")
    string(JSON changed SET "${styleAllocated}" allocations "\"live_memory\"")
  elseif(mutation STREQUAL "allocation-missing")
    string(JSON changed REMOVE "${styleAllocated}" cases 0 frame_allocated_bytes)
  elseif(mutation STREQUAL "allocation-count")
    string(JSON changed SET "${styleAllocated}" cases 0 update_allocations count 2)
  elseif(mutation STREQUAL "allocation-p95")
    string(JSON changed SET "${styleAllocated}" cases 0 update_allocated_bytes p95 0)
  elseif(mutation STREQUAL "allocation-negative")
    string(JSON changed SET "${styleAllocated}" cases 0 frame_allocations samples "[-1,2,3]")
  elseif(mutation STREQUAL "unmarked-allocations")
    string(JSON changed SET "${styleAllocated}" allocations null)
  endif()
  file(WRITE "${root}/style-${mutation}.json" "${changed}")
  record("style-${mutation}" "${root}/style-${mutation}.json" "${root}/metadata.json" style_layers FAIL "${reason}")
endforeach()

# Missing legacy allocation metadata remains unmeasured rather than invented zero.
string(JSON changed REMOVE "${style}" allocations)
file(WRITE "${root}/style-missing-allocations.json" "${changed}")
record(style-missing-allocations "${root}/style-missing-allocations.json" "${root}/metadata.json" style_layers PASS)
compare(style-compare-missing-allocations style-before style-missing-allocations PASS "")

foreach(mutation api controls theme_rules visibility operation update_kind missing-case reordered compiler build assertions_enabled pointer_bits clock
    samples_per_case warmup_per_case frame_workload)
  set(changed "${style}")
  set(changedMetadata "${metadata}")
  set(reason "incompatible actual benchmark workload/signature")
  if(mutation STREQUAL "api" OR mutation STREQUAL "visibility" OR mutation STREQUAL "operation"
      OR mutation STREQUAL "update_kind")
    string(JSON changed SET "${changed}" cases 0 "${mutation}" "\"other scenario\"")
  elseif(mutation STREQUAL "theme_rules")
    string(JSON changed SET "${changed}" cases 0 theme_rules 32)
  elseif(mutation STREQUAL "controls")
    string(JSON changed SET "${changed}" cases 0 controls 64)
  elseif(mutation STREQUAL "missing-case")
    string(JSON changed REMOVE "${changed}" cases 1)
  elseif(mutation STREQUAL "reordered")
    string(JSON changed SET "${changed}" cases "[${styleLegacy},${styleCase}]")
  elseif(mutation STREQUAL "compiler")
    string(JSON changed SET "${changed}" compiler "\"other compiler\"")
    string(JSON changedMetadata SET "${changedMetadata}" toolchain compiler "\"other compiler\"")
    set(reason "incompatible metadata")
  elseif(mutation STREQUAL "build")
    string(JSON changed SET "${changed}" build "\"Debug\"")
    string(JSON changedMetadata SET "${changedMetadata}" configuration "\"Debug\"")
    set(reason "incompatible metadata")
  elseif(mutation STREQUAL "assertions_enabled")
    string(JSON changed SET "${changed}" assertions_enabled true)
  elseif(mutation STREQUAL "pointer_bits")
    string(JSON changed SET "${changed}" pointer_bits 32)
  elseif(mutation STREQUAL "clock" OR mutation STREQUAL "frame_workload")
    string(JSON changed SET "${changed}" "${mutation}" "\"different workload\"")
  elseif(mutation STREQUAL "samples_per_case")
    string(JSON changed SET "${changed}" samples_per_case 2)
    foreach(index RANGE 0 1)
      foreach(phase update frame_render)
        string(JSON changed SET "${changed}" cases ${index} "${phase}"
          "{\"count\":2,\"p50\":1,\"p95\":2,\"samples\":[1,2]}")
      endforeach()
    endforeach()
  elseif(mutation STREQUAL "warmup_per_case")
    string(JSON changed SET "${changed}" warmup_per_case 2)
  endif()
  file(WRITE "${root}/style-signature-${mutation}.json" "${changed}")
  file(WRITE "${root}/style-signature-${mutation}-metadata.json" "${changedMetadata}")
  record("style-signature-${mutation}" "${root}/style-signature-${mutation}.json"
    "${root}/style-signature-${mutation}-metadata.json" style_layers PASS)
  compare("style-compare-signature-${mutation}" style-before "style-signature-${mutation}" FAIL "${reason}")
endforeach()
string(JSON wrongMetadata SET "${metadata}" configuration "\"Debug\"")
file(WRITE "${root}/style-wrong-metadata.json" "${wrongMetadata}")
record(style-provenance "${root}/style.json" "${root}/style-wrong-metadata.json" style_layers FAIL "contradicts raw benchmark")
file(APPEND "${root}/style-after/raw.json" " ")
compare(style-tampered-raw style-before style-after FAIL "SHA256 mismatch")
record(style-tampered-normalized "${root}/style.json" "${root}/metadata.json" style_layers PASS)
file(READ "${root}/style-tampered-normalized/record.json" changed)
string(JSON changed SET "${changed}" normalized metrics 0 value 999)
file(WRITE "${root}/style-tampered-normalized/record.json" "${changed}")
compare(style-tampered-normalized style-before style-tampered-normalized FAIL "differs from its raw input")
