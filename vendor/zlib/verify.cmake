# Check exact upstream bytes offline before compiling the optional adapter.
file(READ "${CMAKE_CURRENT_LIST_DIR}/manifest.json" manifest)
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
  string(JSON name GET "${manifest}" files ${index} name)
  string(JSON expected GET "${manifest}" files ${index} sha256)
  string(JSON expected_size GET "${manifest}" files ${index} bytes)
  file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/${name}" actual)
  file(SIZE "${CMAKE_CURRENT_LIST_DIR}/${name}" actual_size)
  if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
    message(FATAL_ERROR "Pinned zlib artifact changed: ${name}")
  endif()
endforeach()
