# Verify pinned dependency bytes without downloads or private workspace inputs.
file(READ "${CMAKE_CURRENT_LIST_DIR}/manifest.json" portals_monocypher_manifest)
string(JSON portals_monocypher_count LENGTH "${portals_monocypher_manifest}" files)
math(EXPR portals_monocypher_last "${portals_monocypher_count} - 1")
foreach(index RANGE 0 ${portals_monocypher_last})
  string(JSON name GET "${portals_monocypher_manifest}" files ${index} name)
  string(JSON expected GET "${portals_monocypher_manifest}" files ${index} sha256)
  string(JSON expected_size GET "${portals_monocypher_manifest}" files ${index} bytes)
  set(path "${CMAKE_CURRENT_LIST_DIR}/${name}")
  file(SHA256 "${path}" actual)
  file(SIZE "${path}" actual_size)
  if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
    message(FATAL_ERROR "Pinned Monocypher artifact changed: ${name}")
  endif()
endforeach()
