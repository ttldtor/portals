/* Turbo-like palette, encoded as ANSI16 when selected by the output owner. */
* { foreground: #ffff55; background: #0000aa; }
:focused {
  foreground: #0000aa;
  background: #00aaaa;
  bold: true;
  frame-line-foreground: #00aaaa;
  frame-line-background: #0000aa;
  frame-line-bold: true;
  frame-title-foreground: #00aaaa;
  frame-title-background: #0000aa;
  frame-title-bold: true;
  frame-ends-foreground: #00aaaa;
  frame-ends-background: #0000aa;
  frame-ends-bold: true;
  scrollbar-track-foreground: #00aaaa;
  scrollbar-track-background: #0000aa;
  scrollbar-track-bold: true;
  scrollbar-thumb-foreground: #00aaaa;
  scrollbar-thumb-background: #0000aa;
  scrollbar-thumb-bold: true;
  scrollbar-ends-foreground: #00aaaa;
  scrollbar-ends-background: #0000aa;
  scrollbar-ends-bold: true;
  scrollbar-arrows-foreground: #00aaaa;
  scrollbar-arrows-background: #0000aa;
  scrollbar-arrows-bold: true;
  scrollbar-corner-foreground: #00aaaa;
  scrollbar-corner-background: #0000aa;
  scrollbar-corner-bold: true;
}
:disabled { foreground: #aaaaaa; background: #0000aa; bold: false; }
:selected { foreground: #ffff55; background: #aa0000; bold: true; italic: false; }
:header { foreground: #ffffff; background: #0000aa; bold: true; }
:caret { foreground: #00aaaa; background: #0000aa; bold: false; }
