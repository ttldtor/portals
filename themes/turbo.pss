/* Turbo-like palette, encoded as ANSI16 when selected by the output owner. */
* { foreground: #ffff55; background: #0000aa; }
:focused {
  foreground: #0000aa;
  background: #00aaaa;
  bold: true;
  frame-line-foreground: #00aaaa;
  frame-line-background: #0000aa;
  frame-line-bold: true;
  frame-title-foreground: #00aaaa;
  frame-title-background: #0000aa;
  frame-title-bold: true;
  frame-ends-foreground: #00aaaa;
  frame-ends-background: #0000aa;
  frame-ends-bold: true;
  scrollbar-track-foreground: #00aaaa;
  scrollbar-track-background: #0000aa;
  scrollbar-track-bold: true;
  scrollbar-thumb-foreground: #00aaaa;
  scrollbar-thumb-background: #0000aa;
  scrollbar-thumb-bold: true;
  scrollbar-ends-foreground: #00aaaa;
  scrollbar-ends-background: #0000aa;
  scrollbar-ends-bold: true;
  scrollbar-arrows-foreground: #00aaaa;
  scrollbar-arrows-background: #0000aa;
  scrollbar-arrows-bold: true;
  scrollbar-corner-foreground: #00aaaa;
  scrollbar-corner-background: #0000aa;
  scrollbar-corner-bold: true;
}
:disabled { foreground: #aaaaaa; background: #0000aa; bold: false; }
:selected { foreground: #ffff55; background: #aa0000; bold: true; italic: false; }
:header { foreground: #ffffff; background: #0000aa; bold: true; }
:caret { foreground: #00aaaa; background: #0000aa; bold: false; }

/* Document focus uses the text surface; frame and scrollbar keep their accent. */
DocumentView:focused { foreground: #ffff55; background: #0000aa; bold: false; }

/* Slider focus marks the handle; inactive parts keep the theme surface. */
Slider {
  slider-track-foreground: #aaaaaa;
  slider-fill-foreground: #00aaaa;
  slider-thumb-foreground: #ffff55;
}
Slider:focused {
  foreground: #ffff55;
  background: #0000aa;
  bold: false;
  slider-thumb-foreground: #00aaaa;
  slider-thumb-bold: true;
}
Slider:disabled {
  foreground: #aaaaaa;
  background: #0000aa;
  bold: false;
  italic: false;
  underline: false;
  slider-track-foreground: #aaaaaa;
  slider-track-bold: false;
  slider-track-italic: false;
  slider-track-underline: false;
  slider-fill-foreground: #aaaaaa;
  slider-fill-bold: false;
  slider-fill-italic: false;
  slider-fill-underline: false;
  slider-thumb-foreground: #aaaaaa;
  slider-thumb-bold: false;
  slider-thumb-italic: false;
  slider-thumb-underline: false;
}
Slider:read-only {
  foreground: #aaaaaa;
  background: #0000aa;
  bold: false;
  italic: false;
  underline: false;
  slider-track-foreground: #aaaaaa;
  slider-track-bold: false;
  slider-track-italic: false;
  slider-track-underline: false;
  slider-fill-foreground: #aaaaaa;
  slider-fill-bold: false;
  slider-fill-italic: false;
  slider-fill-underline: false;
  slider-thumb-foreground: #aaaaaa;
  slider-thumb-bold: false;
  slider-thumb-italic: false;
  slider-thumb-underline: false;
}

/* Selected radio markers use the surface; read-only remains keyboard navigable. */
RadioGroup:selected { background: #0000aa; }
RadioGroup:read-only { foreground: #aaaaaa; background: #0000aa; bold: false; italic: false; underline: false; }
RadioGroup:read-only:focused {
  foreground: #0000aa;
  background: #00aaaa;
  bold: true;
  frame-line-foreground: #00aaaa;
  frame-line-background: #0000aa;
  frame-line-bold: true;
  frame-title-foreground: #00aaaa;
  frame-title-background: #0000aa;
  frame-title-bold: true;
  frame-ends-foreground: #00aaaa;
  frame-ends-background: #0000aa;
  frame-ends-bold: true;
  scrollbar-track-foreground: #00aaaa;
  scrollbar-track-background: #0000aa;
  scrollbar-track-bold: true;
  scrollbar-thumb-foreground: #00aaaa;
  scrollbar-thumb-background: #0000aa;
  scrollbar-thumb-bold: true;
  scrollbar-ends-foreground: #00aaaa;
  scrollbar-ends-background: #0000aa;
  scrollbar-ends-bold: true;
  scrollbar-arrows-foreground: #00aaaa;
  scrollbar-arrows-background: #0000aa;
  scrollbar-arrows-bold: true;
  scrollbar-corner-foreground: #00aaaa;
  scrollbar-corner-background: #0000aa;
  scrollbar-corner-bold: true;
}

/* Text surfaces retain their palette while focused chrome carries the accent. */
LogView:focused { foreground: #ffff55; background: #0000aa; bold: false; }
